# Copy to .env.local and fill in. Never commit .env.local.

# REQUIRED in production. A random string of at least 32 characters used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If it is missing in production, nobody can sign in (the app fails closed).
AUTH_SECRET=

# Public address of the site (no trailing slash). Used for the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "off" to hide "Explore the demo" and block demo sessions. Do this for a real launch.
NEXT_PUBLIC_DEMO_MODE=on

# Shown on the legal pages. Fill these in and have a lawyer review the pages, then set REVIEWED to 1.
NEXT_PUBLIC_COMPANY_NAME=Cojaunt
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_JURISDICTION_CITY=Bengaluru, Karnataka
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SAFETY_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_LEGAL_REVIEWED=0

# Place-name lookup (see README).
# PLACE_LOOKUP_URL=
# PLACE_LOOKUP_USER_AGENT=
